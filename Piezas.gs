// Piezas de ajedrez embebidas como PNG Base64 (256x256)
const PIEZAS = {
  'K': '',
  'Q': '',
  'R': '',
  'B': '',
  'N': '',
  'P': '',
  'k': '',
  'q': '',
  'r': '',
  'b': '',
  'n': '',
  'p': '',
};

function obtenerBlobPieza(codigo) {
  const datos = PIEZAS_BASE64[codigo];
  if (!datos) return null;
  return Utilities.newBlob(Utilities.base64Decode(datos), 'image/png', codigo + '.png');
}
